# MBR TRACKER - Variáveis de Ambiente para Vercel & Produção

# Chave de API do Google Gemini para Inteligência Financeira e Consultor IA
GEMINI_API_KEY=sua_chave_gemini_aqui

# Conexão com o Supabase (Autenticação + Banco de Dados + RLS)
VITE_SUPABASE_URL=https://sua-instancia.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Service Role Key do Supabase (para criar e gerenciar usuários no painel admin sem confirmação de e-mail)
VITE_SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui
